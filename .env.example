# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Required ────────────────────────────────────────────────────────────────

# Anthropic — LLM for itinerary generation, auto-arrange, and chat
ANTHROPIC_API_KEY=

# Clerk — authentication (sign in / sign up)
# Get from: https://dashboard.clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated origins allowed to present Clerk session tokens (the site's own URL).
# Required behind a reverse proxy so token verification matches the real origin.
# e.g. https://yunhai.io  (staging: https://staging.travelplanner.srv1553531.hstgr.cloud)
CLERK_AUTHORIZED_PARTIES=

# ── Optional ─────────────────────────────────────────────────────────────────

# Google Maps — commute time calculations and distance matrix
GOOGLE_MAPS_API_KEY=

# Google Calendar OAuth — "Sync to Google Calendar" feature
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override only if running behind a proxy or on a non-default port
# GOOGLE_REDIRECT_URI=http://localhost:3457/api/calendar/google/oauth/callback

# Brave Web Search — real-time activity research for planning + chat concierge
# Get from: https://brave.com/search/api/ (free tier: 2000 queries/month)
BRAVE_API_KEY=

# Unsplash — city header images (falls back gracefully if missing)
UNSPLASH_ACCESS_KEY=

# Plan a city as parallel N-day windows (e.g. 2) instead of one call. Roughly a
# 3x speed win on long stays, but it changes the activity mix — leave unset
# until the bake-off has compared split against unsplit.
PLAN_SPLIT_DAYS=

# Resend — transactional email (forwarding address confirmation etc.)
RESEND_API_KEY=

# Email forwarding ingest webhook — shared secret to verify inbound webhook calls.
# Ingest is disabled (503) until this is set — the webhook fails closed.
EMAIL_WEBHOOK_SECRET=

# Clerk userId of the app owner — required for /api/admin/* and /debug endpoints
OWNER_USER_ID=

# Forwarding email domain — e.g. fwd.yourdomain.com
FORWARDING_EMAIL_DOMAIN=

# Server port (defaults to 3457)
# PORT=3457
