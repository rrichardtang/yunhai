# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Required ────────────────────────────────────────────────────────────────

# Anthropic — LLM for itinerary generation, auto-arrange, and chat
ANTHROPIC_API_KEY=

# Clerk — authentication (sign in / sign up)
# Get from: https://dashboard.clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Google Maps — commute time calculations and distance matrix
GOOGLE_MAPS_API_KEY=

# Google Calendar OAuth — "Sync to Google Calendar" feature
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override only if running behind a proxy or on a non-default port
# GOOGLE_REDIRECT_URI=http://localhost:3457/api/calendar/google/oauth/callback

# Unsplash — city header images (falls back gracefully if missing)
UNSPLASH_ACCESS_KEY=

# Resend — transactional email (forwarding address confirmation etc.)
RESEND_API_KEY=

# Email forwarding ingest webhook — shared secret to verify inbound webhook calls
EMAIL_WEBHOOK_SECRET=

# Forwarding email domain — e.g. fwd.yourdomain.com
FORWARDING_EMAIL_DOMAIN=

# Server port (defaults to 3457)
# PORT=3457
