{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/syncClaudeConfig.sh\"",
            "statusMessage": "Syncing global Claude config (caveman, bob-the-builder, felix-the-fixer)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/prePushReview.js",
            "statusMessage": "Checking pre-push review"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/checkPractices.js"
          }
        ]
      }
    ]
  }
}
